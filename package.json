	"main": "dist/index.js",
	"scripts": {
		"dev": "ts-node src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"render-build": "pnpm dlx prisma generate && pnpm build",
		"lint": "eslint src/**/*.ts",
