		"tslog": "^4.10.2",
		"ws": "^8.18.3"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@types/node": "^20.11.5",
		"@types/ws": "^8.18.1",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^9.1.0",
		"prettier": "^3.3.3",
		"prisma": "^6.14.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.3.3",
		"typescript-eslint": "^8.47.0"
